# Local telemetry, private reference photos, artwork experiments
spike/tiny-racers-motion*.json
output/
tmp/

# Third-party source audio is not a standalone asset download.
android-host/app/src/main/assets/audio/*.mp3
marketing/**/*.mp3
marketing/**/*.wav

# Video masters, intermediate frames and large delivery bundles stay local.
marketing/exports/videos/
marketing/exports/frames/
marketing/exports/*.zip
*.mov
*.mp4
*.webm
*.zip

# Build artifacts are ignored except the explicit judge APK.
*.apk
!artifacts/tiny-racers-0.2.0-hackathon.apk
*.aab

# Owner narration takes stay local until mixed into the final demo.
marketing/voiceover/

# Internal instructions and working briefs stay local.
AGENTS.md
CLAUDE.md
.gemini/
tiny-racers-codex-brief/
